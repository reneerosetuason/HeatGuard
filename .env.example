# HeatGuard environment configuration.
# Copy this file to ".env" and fill in your own values.
#   copy .env.example .env     (Windows)
#   cp .env.example .env       (macOS/Linux)

# ---- Flask ----
SECRET_KEY=change-me-to-a-random-string
HOST=127.0.0.1
PORT=5000

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=HeatGuard

# ---- Monitoring / data collection ----
# Open-Meteo current conditions update roughly every 15 minutes.
# FETCH every 10 minutes is responsive without wasting API calls.
MONITOR_ENABLED=1
MONITOR_INTERVAL_SECONDS=600
# A reading older than this is shown as stale (never as "current" or "safe").
STALE_AFTER_SECONDS=1800
# Minimum seconds between two manual refreshes of the same location.
MANUAL_REFRESH_COOLDOWN_SECONDS=60
WEATHER_API_TIMEOUT_SECONDS=12
GEOCODING_TIMEOUT_SECONDS=10

# ---- History defaults ----
HISTORY_DEFAULT_HOURS=24
HISTORY_MAX_HOURS=720
ALERT_HISTORY_LIMIT=20
