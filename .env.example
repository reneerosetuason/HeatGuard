# HeatGuard environment configuration.
# Copy this file to ".env" and fill in your own values.
#   copy .env.example .env     (Windows)
#   cp .env.example .env       (macOS/Linux)

# ---- Flask ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string
HOST=127.0.0.1
PORT=5000
# Additional browser origins allowed to connect to the API.
# run.py automatically supports local Flutter previews on changing ports.
WEB_CORS_ORIGINS=http://localhost:7357,http://127.0.0.1:7357

# ---- Flutter account verification through Gmail ----
# Enable 2-Step Verification and create a Google App Password for HeatGuard.
# Use that app password here, never your normal Google password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=0
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Personal routines: Groq advice and Firebase Android push ----
# Store the service-account JSON outside the repository and Flutter app.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
ROUTINES_ENABLED=1

# ---- Admin and write protection ----
# Set a strong password to allow remote admin sign-in. Leave empty to allow
# changes only from the machine running HeatGuard.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ALLOW_LOCAL_WRITES=1
CSRF_ENABLED=1
SESSION_LIFETIME_HOURS=8
# Set to 1 only when a trusted reverse proxy overwrites X-Forwarded-* headers.
TRUST_PROXY=0
# Set to 1 when the site is served over HTTPS.
SESSION_COOKIE_SECURE=0
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
WRITE_MAX_REQUESTS=60
WRITE_WINDOW_SECONDS=60

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=HeatGuard

# ---- Monitoring / data collection ----
# Open-Meteo current conditions update roughly every 15 minutes.
# FETCH every 10 minutes is responsive without wasting API calls.
MONITOR_ENABLED=1
MONITOR_INTERVAL_SECONDS=600
# A reading older than this is shown as stale (never as "current" or "safe").
STALE_AFTER_SECONDS=1800
# Minimum seconds between two manual refreshes of the same location.
MANUAL_REFRESH_COOLDOWN_SECONDS=60
WEATHER_API_TIMEOUT_SECONDS=12
GEOCODING_TIMEOUT_SECONDS=10

# ---- Installable mobile app daily notifications (Web Push) ----
# Generate a VAPID key pair as described in frontend/web/mobile_app/README.md.
# Keep the private key file and its contents out of source control.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_PATH=
VAPID_PRIVATE_KEY=
# Either set VAPID_PRIVATE_KEY_PATH or VAPID_PRIVATE_KEY, not both.
VAPID_CLAIMS_EMAIL=

# ---- History defaults ----
HISTORY_DEFAULT_HOURS=24
HISTORY_MAX_HOURS=720
ALERT_HISTORY_LIMIT=20
